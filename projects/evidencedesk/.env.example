# Copy to .env and set your own long, random value. Never commit .env.
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Always available offline:
RETRIEVAL_BACKEND=tfidf
INSTALL_SEMANTIC=false
# For real local semantic vectors instead, set both:
# RETRIEVAL_BACKEND=sentence-transformers
# INSTALL_SEMANTIC=true
# Or hosted semantic embeddings (API key required):
# RETRIEVAL_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
